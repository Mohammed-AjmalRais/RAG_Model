# ==============================================================================
# Enterprise Hybrid RAG Configuration
# ==============================================================================
# Choose any LLM provider below. The system automatically detects which key is present.
# If no key is set, the system gracefully operates in Offline Extractive Mode.

# 1. Google Gemini (Recommended - Free Tier Available)
# Get key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Groq (Ultra-Fast Inference - Free Tier Available)
# Get key: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# 3. Anthropic Claude (High Quality)
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 4. OpenAI or Local Ollama
# Get key: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here
# For Local Ollama, set base URL:
# OPENAI_BASE_URL=http://localhost:11434/v1

# Server & UI Configuration
PORT=8000
API_BASE_URL=http://localhost:8000
